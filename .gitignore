# the live database is owned by the runner and never synced —
# a binary file written by one machine and reset by another corrupts.
# Analysis data crosses machines as tester/data/positions.json instead.
tester/data/polymark.db

# diagnostics that MUST be visible across machines — *.log above would
# otherwise silently discard them, which hid the collector failure for days
!tester/data/collector-launch.log
!tester/data/collector-run.log
!collector/data/collector-run.log
!tester/data/runner-exit.log
